APP_PORT=8080
# 镜像版本标签（与 git tag 对齐发布；日常构建用 latest）
APP_VERSION=latest
# WSL用 ./sample_media，上NAS改为 /volume1/video
MEDIA_HOST_PATH=./sample_media
DATA_HOST_PATH=./data
MEDIA_ROOT=/media
DATA_DIR=/app/data
ENV=dev
# TMDB见README申请，WSL可先留空调通骨架
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_PROXY=
TMDB_LANGUAGE=zh-CN
# 仅构建镜像时用：NAS直连留空；本WSL的Docker Desktop拉取/构建需走NAS代理
BUILD_HTTP_PROXY=
# 示例：BUILD_HTTP_PROXY=http://nas:7890
# 宿主UID/GID（WSL填`id -u`/`id -g`，避免容器建的文件宿主删不掉；NAS按DSM用户填）
UID=1000
GID=1000
