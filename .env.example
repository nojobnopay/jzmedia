APP_PORT=8080
# 镜像版本标签（与 git tag 对齐发布；日常构建用 latest）
APP_VERSION=latest
# WSL用 ./media，上NAS改为 /volume1/video
MEDIA_HOST_PATH=./media
DATA_HOST_PATH=./data
MEDIA_ROOT=/media
DATA_DIR=/app/data
ENV=dev
# TMDB见README申请，WSL可先留空调通骨架。
# 首次启动兜底：设置页（/settings → TMDB 配置）设过后以库里的值为准，免重启生效；
# 想改回跟随 .env，在设置页点“恢复跟随 .env”即可。
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_PROXY=
TMDB_LANGUAGE=zh-CN
# 写操作访问令牌（可选）：留空=不鉴权（局域网自用默认）。非空后 POST/PUT/PATCH/DELETE
# 需带 X-Api-Token 头；读取/直链仍免鉴权。也可在设置页「访问控制」里配置（库优先）。
JZMEDIA_TOKEN=
# 仅构建镜像时用：NAS直连留空；本WSL的Docker Desktop拉取/构建需走NAS代理
BUILD_HTTP_PROXY=
# 示例：BUILD_HTTP_PROXY=http://nas:7890
# 宿主UID/GID（WSL填`id -u`/`id -g`；NAS按DSM用户填）。compose 以该用户运行容器，
# 容器创建的文件（NFO/海报/转码产物）属主即该用户。留 0 = root（旧行为，不推荐；
# NAS 上若 DATA_HOST_PATH 属主不是该 UID，需先 `chown -R <UID>:<GID> <数据目录>`）。
UID=1000
GID=1000

# 转码后端：auto(默认；冒烟探测 VAAPI→QSV→NVENC，失败回落软件) | sw | vaapi | qsv | nvenc
# NAS 启用硬件转码还需 compose 里映射 /dev/dri（见 docker-compose.yml 注释）
TRANSCODER=auto
# 应用内挂载 SMB/NFS 远程库（需 compose cap_add: [SYS_ADMIN]）；0=禁用，只允许宿主挂载后登记 local
ALLOW_SMB_MOUNT=1
# SMB 库访问方式：auto(默认；挂载点可用走挂载，否则用户态直读) | direct(强制直读，免挂载)
# | mount(强制挂载兼容模式)。直读走进程内 SMB2/3 + 内网 Range 代理，无需 SYS_ADMIN。
SMB_DRIVER=auto
# 直读连接超时（秒）与内网 Range 代理监听地址（默认仅回环，勿改公网）
SMB_CONNECT_TIMEOUT=15
MEDIA_PROXY_HOST=127.0.0.1
# 直读库性能调优（默认值适用于 NAS；排障/对比时可调）：
# - 元数据缓存 TTL（秒）：stat/list 命中免网络往返，写路径即时失效；0=关闭
SMB_META_TTL=3
# - 读句柄池：流式播放/Range 请求复用 SMB 句柄（省 Create/Close）；0=关闭
SMB_HANDLE_POOL=8
# - 空闲句柄保留秒数（超过即关闭）
SMB_HANDLE_TTL=30
# - smbprotocol 库日志级别：默认 WARNING（否则每次线上操作两行 INFO 刷屏）；
#   排障时设 DEBUG/INFO 单独放开
SMB_LOG_LEVEL=WARNING
# TV 落盘（T3）：逐集 NFO 默认仅本地库写（远程 SMB 单文件原子写 ~1.6s，千集级 ~1.7h）；
# 需要 Kodi/Jellyfin 离线集元数据时置 1（也可用 job rebuild-tv-nfo 的 episodes:true）
TV_EPISODE_NFO=
# 可选 .plexmatch（Plex 匹配提示：title/year/tmdb/tvdb），默认不写
TV_PLEXMATCH=
# 播放/转码调优（默认值适用于常见场景；慢链路/弱机可调）：
# - 首屏等待分片数：copy/remux 档（分片按源码 GOP 切，可能 9s/片）与转码/烧录档分开；
#   越小起播越快、首屏缓冲越薄
MIN_SEGS_COPY=1
MIN_SEGS_TRANSCODE=2
# - 远程输入（直读库经内网 Range 代理）的 ffmpeg 探测限制：默认 5MB/5s 在慢链路上首帧前
#   要白读十几 MB；本地文件不受影响。0=不限；rw_timeout 单位微秒（默认 30s），0=关闭
FFMPEG_PROBESIZE=2097152
FFMPEG_ANALYZEDURATION=1000000
FFMPEG_RW_TIMEOUT_US=30000000
# - 转码/预缓存产物总量上限（GB）：超限按最旧淘汰到 90%（跳过在播会话），0=只按 24h TTL；
#   设置页「高级维护 → 清理转码缓存」可手动清
TRANSCODE_CACHE_GB=10
# 元数据降级来源（E 阶段）：豆瓣爬虫默认关（仅提示候选）；IMDb 数据集导入用路径
DOUBAN_ENABLED=
IMDB_DATASET_PATH=
# Bangumi 公开 API 的 User-Agent（无 token 外源；建议带联系方式）
BANGUMI_UA=
