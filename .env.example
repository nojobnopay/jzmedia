APP_PORT=8080
# 镜像版本标签（与 git tag 对齐发布；日常构建用 latest）
APP_VERSION=latest
# WSL用 ./sample_media，上NAS改为 /volume1/video
MEDIA_HOST_PATH=./sample_media
DATA_HOST_PATH=./data
MEDIA_ROOT=/media
DATA_DIR=/app/data
ENV=dev
# TMDB见README申请，WSL可先留空调通骨架。
# 首次启动兜底：设置页（/settings → TMDB 配置）设过后以库里的值为准，免重启生效；
# 想改回跟随 .env，在设置页点“恢复跟随 .env”即可。
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_PROXY=
TMDB_LANGUAGE=zh-CN
# 写操作访问令牌（可选）：留空=不鉴权（局域网自用默认）。非空后 POST/PUT/PATCH/DELETE
# 需带 X-Api-Token 头；读取/直链仍免鉴权。也可在设置页「访问控制」里配置（库优先）。
JZMEDIA_TOKEN=
# 仅构建镜像时用：NAS直连留空；本WSL的Docker Desktop拉取/构建需走NAS代理
BUILD_HTTP_PROXY=
# 示例：BUILD_HTTP_PROXY=http://nas:7890
# 宿主UID/GID（WSL填`id -u`/`id -g`；NAS按DSM用户填）。compose 以该用户运行容器，
# 容器创建的文件（NFO/海报/转码产物）属主即该用户。留 0 = root（旧行为，不推荐；
# NAS 上若 DATA_HOST_PATH 属主不是该 UID，需先 `chown -R <UID>:<GID> <数据目录>`）。
UID=1000
GID=1000

# 转码后端：auto(默认；冒烟探测 VAAPI→QSV→NVENC，失败回落软件) | sw | vaapi | qsv | nvenc
# NAS 启用硬件转码还需 compose 里映射 /dev/dri（见 docker-compose.yml 注释）
TRANSCODER=auto
