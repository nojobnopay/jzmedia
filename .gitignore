# Local configuration and Python caches
.env
# 本机专属（2026-10-10）：含本机主机名/网络/挂载信息，不入库，只存本地工作区
/AGENTS.md
/docker-compose.override.yml
/compose.mihomo.yml
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime state and user media (keep only directory placeholders)
/data/*
!/data/.gitkeep
/media/*
!/media/.gitkeep

# Dependencies and rebuildable web/documentation output
node_modules/
frontend/dist/
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/.temp/
docs/.vitepress/generated/
docs/.artifacts/
dist/

# Local screenshots, validation reports, APKs and browser session artifacts
/output/
.playwright-cli/

# Private operational records, including legacy report locations
docs/private/
docs/tv-organize-moves-*.json
docs/tv-fix-and-pending-*.md
